@subfile
@strict

$SDL2_CFLAGS ``= ["pkg-config", "sdl2", "--cflags"]
$AVF_CFLAGS ``= ["pkg-config", "libavformat", "--cflags"]
$AVU_CFLAGS ``= ["pkg-config", "libavutil", "--cflags"]
$AVC_CFLAGS ``= ["pkg-config", "libavcodec", "--cflags"]
$SIO_CFLAGS ``= ["sh", "-c", "pkg-config sndio --exists && pkg-config sndio --cflags || echo"]
$SDL2_LIBS ``= ["pkg-config", "sdl2", "--libs"]
$AVF_LIBS ``= ["pkg-config", "libavformat", "--libs"]
$AVU_LIBS ``= ["pkg-config", "libavutil", "--libs"]
$AVC_LIBS ``= ["pkg-config", "libavcodec", "--libs"]
$SIO_LIBS ``= ["sh", "-c", "pkg-config sndio --exists && pkg-config sndio --libs || echo -lsndio"]
$CFLAGS += [@$SDL2_CFLAGS, @$AVF_CFLAGS, @$AVU_CFLAGS, @$AVC_CFLAGS, @$SIO_CFLAGS]
$LIBS = [@$SDL2_LIBS, @$AVF_LIBS, @$AVU_LIBS, @$AVC_LIBS, @$SIO_LIBS, "-lm"]

@phonyrule: 'all': 'mploopplayer'

@distrule: 'mploopplayer': 'mploopplayer.c'
@	[$(CC), "-o", "mploopplayer", "mploopplayer.c", @$(CFLAGS), @$(LIBS)]
