@toplevel
@strict

$(CC) ?= @nil
@if(@type($(CC)) == @type(@nil))
  $(CC) ``= ["sh", "-c", "echo $CC"]
  @if($(CC)[] == 0)
    $(CC) = ["cc"]
  @endif
@endif

$(AR) ?= @nil
@if(@type($(AR)) == @type(@nil))
  $(AR) ``= ["sh", "-c", "echo $AR"]
  @if($(AR)[] == 0)
    $(AR) = ["ar"]
  @endif
@endif

$(CFLAGS) ?= @nil
@if(@type($(CFLAGS)) == @type(@nil))
  $(CFLAGS) ``= ["sh", "-c", "echo $CFLAGS"]
  @if($(CFLAGS)[] == 0)
    $(CFLAGS) = ["-O3", "-Wall", "-Wextra", "-Wno-unused-parameter", "-std=gnu99", "-Wno-unused-function", "-pedantic", "-Wsign-conversion"]
  @endif
@endif

$(LDFLAGS) ?= @nil
@if(@type($(LDFLAGS)) == @type(@nil))
  $(LDFLAGS) ``= ["sh", "-c", "echo $LDFLAGS"]
  @if($(LDFLAGS)[] == 0)
    $(LDFLAGS) = []
  @endif
@endif


@phonyrule: 'all': 'mploopplayer/all'

@dirinclude ["mploopplayer"]
